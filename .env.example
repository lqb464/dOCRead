# dOCRead OCR Configuration
HOST=127.0.0.1
PORT=8002

# auto | cuda | cpu  (server path: CUDA → CPU when auto)
OCR_RUNTIME=auto

# Recognition language hint: en and/or vi (vi → latin rec model)
OCR_LANG=en,vi

# Downscale longest side before OCR (latency / memory)
OCR_MAX_SIDE=1280

# ONNX Runtime CPU threads
OCR_INTRA_OP_THREADS=4

# PP-OCRv4 | PP-OCRv5 | PP-OCRv6
OCR_VERSION=PP-OCRv4
OCR_MODEL_TYPE=mobile
